# ==============================================================================
# Elixir Enterprise Information Management (Elixir EIM) - Environment Variables
# ==============================================================================

# Platform & Deployment
ELIXIR_ENV=development
ELIXIR_DEBUG=true
ELIXIR_SECRET_KEY=change-me-in-production-use-strong-entropy-minimum-32-chars
ELIXIR_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL 16 with RLS support)
# Application runtime connects as non-superuser elixir_app_role (enforces PostgreSQL RLS)
DATABASE_URL=postgresql+asyncpg://elixir_app_role:app_secure_pass@localhost:5432/elixir_eim
DATABASE_URL_SYNC=postgresql+psycopg://elixir_app_role:app_secure_pass@localhost:5432/elixir_eim
MIGRATION_DATABASE_URL=postgresql+asyncpg://elixir:elixir_secure_pass@localhost:5432/elixir_eim
MIGRATION_DATABASE_URL_SYNC=postgresql+psycopg://elixir:elixir_secure_pass@localhost:5432/elixir_eim
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Cache & Message Broker (Redis 7)
REDIS_URL=redis://:redis_secure_pass@localhost:6379/0

# Object Storage (S3 / MinIO)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin_secure
S3_BUCKET_NAME=elixir-eim-content
S3_QUARANTINE_BUCKET=elixir-eim-quarantine
S3_REGION=us-east-1

# Policy Engine (Open Policy Agent)
OPA_URL=http://localhost:8181/v1/data/elixir/authz

# Identity & OIDC (Keycloak / Entra ID)
OIDC_ISSUER_URL=http://localhost:8080/realms/elixir
OIDC_CLIENT_ID=elixir-eim-api
OIDC_CLIENT_SECRET=keycloak-client-secret-placeholder
OIDC_ALGORITHMS=RS256

# Content Processing & Scanners
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
GOTENBERG_URL=http://localhost:3000

# Observability & Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=elixir-eim-api
LOG_LEVEL=INFO
LOG_FORMAT=json
